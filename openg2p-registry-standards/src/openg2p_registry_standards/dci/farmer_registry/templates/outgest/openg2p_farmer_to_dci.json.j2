{% set d = expanded %}

{% set farmer_list = d.get('farmer') or [] %}
{% set farmer = d if d.get('foundational_id') is not none or d.get('first_name') is not none or d.get('land') is not none or d.get('membership_details') is not none or d.get('disabled') is not none else (farmer_list[0] if farmer_list else {}) %}
{% set household = farmer.get('household') or (d if d.get('household_member') is not none or d.get('score') is not none or d.get('size_of_group') is not none else {}) %}

{% set foundational_id = farmer.get('foundational_id', '') %}
{% set first_name = farmer.get('first_name', '') %}
{% set last_name = farmer.get('last_name', '') %}
{% set birth_date = farmer.get('birth_date', '') %}
{% set gender = farmer.get('gender', '') %}
{% set is_disabled = farmer.get('disabled', farmer.get('is_disabled', false)) %}
{% set marital_status = farmer.get('marital_status', '') %}
{% set registration_date = farmer.get('registration_date', farmer.get('created_at', '')) %}
{% set last_approved_at = farmer.get('last_approved_at', '') %}

{% set household_functional_id = household.get('functional_record_id', '') %}
{% set score_records = household.get('score') or d.get('score') or farmer.get('score') or [] %}
{% set selected_score = namespace(record={}) %}
{% for score_record in score_records %}
{% if not selected_score.record and score_record.get('score_type', '') | lower in ['poverty', 'poverty_score', 'pmt', 'pmt_score'] %}
{% set selected_score.record = score_record %}
{% endif %}
{% endfor %}
{% set first_score = selected_score.record or (score_records[0] if score_records else {}) %}
{% set poverty_score = first_score.get('computed_score', '') %}
{% set poverty_score_type = first_score.get('score_type', '') %}
{% set household_members = household.get('household_member') or [] %}
{% set household_registration_date = household.get('created_at', '') %}
{% set household_last_approved = household.get('last_approved_at', '') %}

{% set land_list = farmer.get('land') or [] %}
{% set machinery_list = farmer.get('machinery') or [] %}

{
  "famer_personal_details": {
    "member_identifier": {
      "identifier_type": "UIN"
      ,"identifier_value": "{{ foundational_id }}"
    }
    ,"demographic_info": {
      "identifier": {
        "identifier_type": "UIN"
        ,"identifier_value": "{{ foundational_id }}"
      }
      ,"name": {
        "first_name": "{{ first_name }}"
        ,"last_name": "{{ last_name }}"
      }
      ,"date_of_birth": "{{ birth_date }}"
      ,"gender": "{{ gender | lower }}"
    }
  }
  ,"family_details": {
    "group_identifier": [
      {
        "identifier_type": "UIN"
        ,"identifier_value": "{{ household_functional_id }}"
      }
    ]
    ,"group_type": "family"
    ,"poverty_score": "{{ poverty_score }}"
    ,"poverty_score_type": "{{ poverty_score_type }}"
    ,"group_head_info": {
      "member_identifier": [
        {
          "identifier_type": "UIN"
          ,"identifier_value": "{{ foundational_id }}"
        }
      ]
      ,"demographic_info": {
        "identifier": {
          "identifier_type": "UIN"
          ,"identifier_value": "{{ foundational_id }}"
        }
        ,"name": {
          "first_name": "{{ first_name }}"
          ,"last_name": "{{ last_name }}"
        }
        ,"date_of_birth": "{{ birth_date }}"
        ,"gender": "{{ gender | lower }}"
      }
      ,"is_disabled": {{ 'true' if is_disabled else 'false' }}
      ,"marital_status": "{{ marital_status | lower }}"
      ,"registration_date": "{{ registration_date }}"
    }
    ,"group_size": {{ household.get('size_of_group', household_members | length) or 0 }}
    ,"member_list": [
      {% for member in household_members %}
      {
        "member_identifier": [
          {
            "@type": "Identifier"
            ,"identifier_type": "UIN"
            ,"identifier_value": "{{ member.get('foundational_id', '') }}"
          }
        ]
        ,"demographic_info": {
          "spdci:identifier": [
            {
              "@type": "Identifier"
              ,"identifier_type": "UIN"
              ,"identifier_value": "{{ member.get('foundational_id', '') }}"
            }
          ]
          ,"name": {
            "@type": "Name"
            ,"surname": "{{ member.get('last_name', '') }}"
            ,"given_name": "{{ member.get('first_name', '') }}"
            ,"prefix": "{{ member.get('prefix', '') }}"
            ,"suffix": "{{ member.get('suffix', '') }}"
          }
          ,"sex": "{{ member.get('gender', '') | lower }}"
          ,"birth_date": "{{ member.get('birth_date', '') }}"
          ,"registration_date": "{{ member.get('registration_date', '') }}"
        }
        ,"is_disabled": {{ 'true' if member.get('is_disabled', false) else 'false' }}
        ,"marital_status": "{{ member.get('marital_status', '') | lower }}"
        ,"registration_date": "{{ member.get('registration_date', '') }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
    ,"registration_date": "{{ household_registration_date }}"
    ,"last_updated": "{{ household_last_approved }}"
  }
  ,"farm_details": [
    {% for land in land_list %}
    {
      {% set farm_inputs = land.get('farm_inputs') or [] %}
      {% set first_farm_input = farm_inputs[0] if farm_inputs else {} %}
      "place": {
        "name": "{{ land.get('address_line_2', '') }}"
        ,"geo": {
          "@type": "spdci:GeoLocation"
          ,"latitude": {{ land.get('latitude') or 0 }}
          ,"longitude": {{ land.get('longitude') or 0 }}
        }
      }
      ,"farm_type": ""
      ,"farming_activities": [
        {
          "crop_production": [
            {% for crop in land.get('crop') or [] %}
            {% set commodity = crop.get('commodity', '') %}
            {% set water_source = crop.get('irrigation_water', first_farm_input.get('water_source', '')) %}
            {% set irrigation = crop.get('irrigation', water_source) %}
            {% set fertilizer_type = crop.get('fertilizer_type', 'fertilizer' if first_farm_input.get('fertilizer_use', false) else '') %}
            {
              "activity_group": "{{ crop.get('activity_group', commodity) }}"
              ,"crop_type": "{{ crop.get('crop_type', commodity) }}"
              ,"variety": "{{ crop.get('variety', '') }}"
              ,"season": "{{ crop.get('season', '') }}"
              ,"end_use": [
                "{{ crop.get('end_use', '') }}"
              ]
              ,"irrigation": {{ 'false' if not irrigation or irrigation == 'Rainfed' else 'true' }}
              ,"irrigation_water": [
                "{{ water_source }}"
              ]
              ,"fertilizer_type": [
                "{{ fertilizer_type }}"
              ]
              ,"registration_date": "{{ crop.get('created_at', '') }}"
              ,"last_updated": "{{ crop.get('last_approved_at', '') }}"
            }{% if not loop.last %},{% endif %}
            {% endfor %}
          ]
          ,"animal_production": [
            {% for livestock in land.get('livestock') or [] %}
            {
              "type": "{{ livestock.get('livestock_type', '') }}"
              ,"count": {{ livestock.get('head_count', livestock.get('count', 0)) or 0 }}
              ,"livestock_system": "{{ livestock.get('livestock_system', '') }}"
              ,"registration_date": "{{ livestock.get('created_at', '') }}"
              ,"last_updated": "{{ livestock.get('last_approved_at', '') }}"
            }{% if not loop.last %},{% endif %}
            {% endfor %}
          ]
          ,"mixed_farming": {{ 'true' if ((land.get('crop') or []) | length > 0 and (land.get('livestock') or []) | length > 0) else 'false' }}
          ,"agri_support_activities": [
            {% if first_farm_input.get('access_to_finance', false) %}"access_to_finance"{% endif %}{% if first_farm_input.get('access_to_finance', false) and first_farm_input.get('improved_seed_use', false) %},{% endif %}
            {% if first_farm_input.get('improved_seed_use', false) %}"improved_seed_use"{% endif %}
          ]
          ,"aqua_support_activities": ""
          ,"aqua_culture": ""
          ,"registration_date": "{{ land.get('created_at', '') }}"
          ,"last_updated": "{{ land.get('last_approved_at', '') }}"
        }
      ]
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
  ,"machineries_details": [
    {% for machinery in machinery_list %}
    {
      "type": "{{ machinery.get('machinery_type', machinery.get('type', '')) }}"
      ,"count": {{ machinery.get('count', 0) }}
      ,"equipement_source": "{{ machinery.get('equipment_source', machinery.get('equipement_source', '')) }}"
      ,"registration_date": "{{ machinery.get('created_at', '') }}"
      ,"last_updated": "{{ machinery.get('last_approved_at', '') }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
  ,"registration_date": "{{ registration_date }}"
  ,"last_updated": "{{ last_approved_at }}"
}