{% set d = expanded %}

{% set foundational_id = d.get('foundational_id', '') %}
{% set first_name = d.get('first_name', '') %}
{% set last_name = d.get('last_name', '') %}
{% set birth_date = d.get('birth_date', '') %}
{% set gender = d.get('gender', '') %}
{% set is_disabled = d.get('is_disabled', false) %}
{% set marital_status = d.get('marital_status', '') %}
{% set registration_date = d.get('registration_date', '') %}
{% set last_approved_at = d.get('last_approved_at', '') %}
{% set link_internal_record_id = d.get('link_internal_record_id', '') %}

{
  "famer_personal_details": {
    "member_identifier": {
      "identifier_type": "UIN",
      "identifier_value": "{{ foundational_id }}"
    },
    "demographic_info": {
      "identifier": {
        "identifier_type": "UIN",
        "identifier_value": "{{ foundational_id }}"
      },
      "name": {
        "first_name": "{{ first_name }}",
        "last_name": "{{ last_name }}"
      },
      "date_of_birth": "{{ birth_date }}",
      "gender": "{{ gender | lower }}"
    }
  },
  "family_details": {
    "group_identifier": [
      {
        "identifier_type": "FAM",
        "identifier_value": "{{ link_internal_record_id }}"
      }
    ],
    "group_type": "family",
    "poverty_score": "",
    "poverty_score_type": "",
    "group_head_info": {
      "member_identifier": [
        {
          "identifier_type": "UIN",
          "identifier_value": "{{ foundational_id }}"
        }
      ],
      "demographic_info": {
        "identifier": {
          "identifier_type": "UIN",
          "identifier_value": "{{ foundational_id }}"
        },
        "name": {
          "first_name": "{{ first_name }}",
          "last_name": "{{ last_name }}"
        },
        "date_of_birth": "{{ birth_date }}",
        "gender": "{{ gender | lower }}"
      },
      "is_disabled": {{ 'true' if is_disabled else 'false' }},
      "marital_status": "{{ marital_status | lower }}",
      "registration_date": "{{ registration_date }}"
    },
    "group_size": 0,
    "member_list": [],
    "registration_date": "{{ registration_date }}",
    "last_updated": "{{ last_approved_at }}"
  },
  "farm_details": [],
  "machineries_details": [],
  "registration_date": "{{ registration_date }}",
  "last_updated": "{{ last_approved_at }}"
}