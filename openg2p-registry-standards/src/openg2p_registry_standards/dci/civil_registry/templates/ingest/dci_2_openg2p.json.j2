{% set p = expanded[0] %}

{% set name0 = (p.get('https://schema.spdci.org/common/v1name', [{}]) | first) %}
{% set birth_place0 = (p.get('https://schema.spdci.org/common/v1birth_place', [{}]) | first) %}
{% set birth_geo0 = (birth_place0.get('https://schema.spdci.org/common/v1geo', [{}]) | first) %}
{% set address0 = (p.get('https://schema.spdci.org/common/v1address', [{}]) | first) %}
{% set geo_loc0 = (address0.get('https://schema.spdci.org/common/v1geo_location', [{}]) | first) %}
{% set plus_code0 = (geo_loc0.get('https://schema.spdci.org/common/v1plus_code', [{}]) | first) %}
{% set geometry0 = (plus_code0.get('https://schema.spdci.org/common/v1geometry', [{}]) | first) %}
{% set location0 = (geometry0.get('https://schema.spdci.org/common/v1location', [{}]) | first) %}
{% set identifier0 = (p.get('https://schema.spdci.org/common/v1identifier', [{}]) | first) %}

{
  "surname": "{{ (name0.get('https://schema.spdci.org/common/v1surname', [{}]) | first).get('@value','') }}",
  "given_name": "{{ (name0.get('https://schema.spdci.org/common/v1given_name', [{}]) | first).get('@value','') }}",
  "second_name": "{{ (name0.get('https://schema.spdci.org/common/v1second_name', [{}]) | first).get('@value','') }}",
  "prefix": "{{ (name0.get('https://schema.spdci.org/common/v1prefix', [{}]) | first).get('@value','') }}",
  "suffix": "{{ (name0.get('https://schema.spdci.org/common/v1suffix', [{}]) | first).get('@value','') }}",

  "phone_numbers": [
    {% for ph in p.get('https://schema.spdci.org/common/v1phone_number', []) %}
      "{{ ph.get('@value','') }}"{% if not loop.last %},{% endif %}
    {% endfor %}
  ],

  "emails": [
    {% for em in p.get('https://schema.spdci.org/common/v1email', []) %}
      "{{ em.get('@value','') }}"{% if not loop.last %},{% endif %}
    {% endfor %}
  ],

  "sex": "{{ (p.get('https://schema.spdci.org/common/v1sex', [{}]) | first).get('@value','') }}",
  "birth_date": "{{ (p.get('https://schema.spdci.org/common/v1birth_date', [{}]) | first).get('@value','') }}",

  "birth_place_name": "{{ (birth_place0.get('https://schema.spdci.org/common/v1name', [{}]) | first).get('@value','') }}",
  "birth_place_lat": {{ (birth_geo0.get('https://schema.spdci.org/common/v1latitude', [{}]) | first).get('@value', 'null') }},
  "birth_place_lng": {{ (birth_geo0.get('https://schema.spdci.org/common/v1longitude', [{}]) | first).get('@value', 'null') }},

  "death_date": "{{ (p.get('https://schema.spdci.org/common/v1death_date', [{}]) | first).get('@value','') }}",
  "death_place": "{{ (p.get('https://schema.spdci.org/common/v1death_place', [{}]) | first).get('@value','') }}",

  "address_line1": "{{ (address0.get('https://schema.spdci.org/common/v1address_line1', [{}]) | first).get('@value','') }}",
  "address_line2": "{{ (address0.get('https://schema.spdci.org/common/v1address_line2', [{}]) | first).get('@value','') }}",
  "locality": "{{ (address0.get('https://schema.spdci.org/common/v1locality', [{}]) | first).get('@value','') }}",
  "administrative_area_small_id": "{{ (address0.get('https://schema.spdci.org/common/v1sub_region_code', [{}]) | first).get('@value','') }}",
  "administrative_area_large_id": "{{ (address0.get('https://schema.spdci.org/common/v1region_code', [{}]) | first).get('@value','') }}",
  "postal_code": "{{ (address0.get('https://schema.spdci.org/common/v1postal_code', [{}]) | first).get('@value','') }}",
  "country_code": "{{ (address0.get('https://schema.spdci.org/common/v1country_code', [{}]) | first).get('@value','') }}",

  "plus_code": "{{ (plus_code0.get('https://schema.spdci.org/common/v1global_code', [{}]) | first).get('@value','') }}",

  "geo_lat": {{ (location0.get('https://schema.spdci.org/common/v1latitude', [{}]) | first).get('@value','null') }},
  "geo_lng": {{ (location0.get('https://schema.spdci.org/common/v1longitude', [{}]) | first).get('@value','null') }},

  "marital_status": "{{ (p.get('https://schema.spdci.org/common/v1marital_status', [{}]) | first).get('@value','') }}",
  "marriage_date": "{{ (p.get('https://schema.spdci.org/common/v1marriage_date', [{}]) | first).get('@value','') }}",
  "divorce_date": "{{ (p.get('https://schema.spdci.org/common/v1divorce_date', [{}]) | first).get('@value','') }}",

  "link_internal_record_id": "{{ (p.get('https://schema.spdci.org/common/v1link_internal_record_id', [{}]) | first).get('@value','') }}",
  "foundational_id": "{{ (identifier0.get('https://schema.spdci.org/common/v1identifier_value', [{}]) | first).get('@value','') }}",

  "edit_action": "ADD",
  "internal_record_id": ""
}
